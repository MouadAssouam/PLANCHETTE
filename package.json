{
  "name": "planchette",
  "private": true,
  "version": "0.0.0",
  "description": "Hands-free talking board for awake ICU patients who can't speak or use their hands. A prototype, not a medical device.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:task": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "fast-check": "^4.11.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  }
}
